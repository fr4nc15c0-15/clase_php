{% extends 'base.html.twig' %}
{% block title %}Detalle libro{% endblock %}
{% block body %}
<h1>{{ libro.titulo }}</h1>
<p><strong>Autor:</strong> {{ libro.autor }}</p>
<p><strong>Descripción:</strong> {{ libro.descripcion }}</p>
<p><strong>Precio:</strong> {{ libro.precio }} €</p>
<p><strong>Estado:</strong> {{ libro.estado }}</p>
<p><strong>Categoría:</strong> {{ libro.categoria.nombre }}</p>

<form method="post" action="{{ path('app_libro_delete', {id: libro.id}) }}" onsubmit="return confirm('¿Seguro?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete_libro_' ~ libro.id) }}">
    <button>Borrar</button>
</form>
{% endblock %}
